{
	"name": "remark-enhance-codeblock",
	"version": "1.1.1",
	"description": "enhance markdown codeblock",
	"license": "MIT",
	"author": {
		"email": "oss@vnphanquang.com",
		"name": "quang",
		"url": "https://github.com/vnphanquang"
	},
	"homepage": "https://github.com/vnphanquang/remark-enhance-codeblock",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vnphanquang/remark-enhance-codeblock.git"
	},
	"bugs": {
		"url": "https://github.com/vnphanquang/remark-enhance-codeblock/issues"
	},
	"keywords": [
		"remark",
		"unified",
		"codeblock",
		"enhance",
		"ux",
		"group"
	],
	"type": "module",
	"main": "src/index.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/index.js"
		},
		"./client": {
			"types": "./types/index.d.ts",
			"import": "./src/client/index.js"
		},
		"./styles/*.css": "./styles/*.css",
		"./styles/bare/*.css": "./styles/bare/*.css"
	},
	"files": [
		"src",
		"!src/styles",
		"types",
		"styles",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"lint:es": "eslint .",
		"lint:style": "stylelint \"**/*.css\"",
		"lint": "run-p lint:*",
		"format": "prettier . --check",
		"build": "pnpm dts && pnpm build:css && publint",
		"build:css": "postcss \"src/styles/*.css\" --dir styles --map && postcss \"src/styles/bare/*.css\" --dir styles/bare --map",
		"dts": "dts-buddy --write",
		"test": "vitest --coverage --browser.headless",
		"ci:test": "vitest run --coverage --browser.headless --project=!visual"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@hono/vite-dev-server": "^0.26.1",
		"@playwright/test": "1.61.1",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.4.0",
		"@types/unist": "^3.0.3",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"@vnphanquang/eslint-config": "^4.2.1",
		"cssnano": "^9.0.1",
		"dedent": "^1.7.2",
		"dts-buddy": "^0.8.3",
		"eslint": "^10.9.1",
		"eslint-plugin-jsdoc": "^64.2.1",
		"hast-util-select": "^6.0.4",
		"hast-util-to-html": "^9.0.5",
		"hast-util-to-string": "^3.0.1",
		"hono": "^4.13.5",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-to-hast": "^13.2.1",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.26",
		"postcss-cli": "^11.0.1",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-embed": "^0.5.1",
		"publint": "^0.3.24",
		"rehype-stringify": "^10.0.1",
		"remark-codeblock-source": "^1.0.3",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"stylelint": "^17.14.1",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^6.0.0",
		"unified": "^11.0.5",
		"unist-util-select": "^5.1.0",
		"vfile": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-qrcode": "^0.4.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"remark-transform-blockquote": "^1.2.2",
		"unist-builder": "^4.0.0",
		"unist-util-visit": "^5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.16.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^11.25.0",
			"onFail": "download"
		}
	}
}
